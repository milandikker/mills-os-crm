# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.
#
# This is a dedicated Postgres instance for Meleh Studio's social agent
# only. It is not shared with Jarvis or any other project on the VPS.

# --- Postgres (step a) ---
POSTGRES_USER=meleh_social
POSTGRES_PASSWORD=changeme
POSTGRES_DB=meleh_social
# Inside docker-compose, other services reach Postgres by service name.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Poster Agent (step b) ---
# How often it checks the queue for approved rows, in seconds (3600 = 1h).
POSTER_INTERVAL_SECONDS=3600
# How many times to retry a failed publish before giving up (row stays
# 'failed' for good after this many attempts).
POSTER_MAX_RETRIES=3

# --- Telegram Review Bot (step d) ---
# Create a bot via @BotFather, then message it once so you can find your
# chat ID (e.g. via @userinfobot or the getUpdates API).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Future integrations -- not used yet, see TODO stubs (step e) ---
OPENAI_API_KEY=
HIGGSFIELD_API_KEY=
META_GRAPH_API_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=
TIKTOK_ACCESS_TOKEN=
