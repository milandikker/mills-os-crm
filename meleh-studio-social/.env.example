# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.
#
# This is a dedicated Postgres instance for Meleh Studio's social agent
# only. It is not shared with Jarvis or any other project on the VPS.

# --- Postgres (step a) ---
POSTGRES_USER=meleh_social
POSTGRES_PASSWORD=changeme
POSTGRES_DB=meleh_social
# Inside docker-compose, other services reach Postgres by service name.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Poster Agent (step b) ---
# How often it checks the queue for approved rows, in seconds (3600 = 1h).
POSTER_INTERVAL_SECONDS=3600
# How many times to retry a failed publish before giving up (row stays
# 'failed' for good after this many attempts).
POSTER_MAX_RETRIES=3

# --- Content Agent dashboard (step c) ---
# Basic-auth login for the manual content dashboard. Pick your own
# username/password -- these gate the whole dashboard, so don't leave
# them blank.
CONTENT_STUDIO_USERNAME=
CONTENT_STUDIO_PASSWORD=
# Random string used to sign Flask's session cookie (only used for one-time
# flash messages here, but Flask requires it regardless). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CONTENT_STUDIO_SECRET_KEY=

# --- Telegram Review Bot (step d) ---
# Create a bot via @BotFather, then message it once so you can find your
# chat ID (e.g. via @userinfobot or the getUpdates API).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Future integrations -- not used yet, see TODO stubs (step e) ---
OPENAI_API_KEY=
# Image/video generation for step (e). Runway chosen over Higgsfield --
# reliability issues seen using Higgsfield via ChatGPT (hit-or-miss,
# occasional long delays). Get a key from Runway's developer dashboard.
RUNWAY_API_KEY=
META_GRAPH_API_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=
TIKTOK_ACCESS_TOKEN=
